config_version=5
[application]
config/name="Lulu"
config/use_custom_user_dir=true
config/custom_user_dir_name="Lulu/window"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=528
window/size/viewport_height=420
window/size/window_width_override=528
window/size/window_height_override=420
window/size/borderless=true
window/size/resizable=false
window/size/transparent=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0,0,0,0)
textures/default_filters/use_nearest_mipmap_filter=false
